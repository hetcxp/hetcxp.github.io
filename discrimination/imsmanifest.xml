<?xml version="1.0" standalone="no" ?>
<manifest identifier="com.cursodiscriminacion.v1" version="1.0"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd
                              http://www.imsglobal.org/xsd/imsmd_rootv1p2p1 imsmd_rootv1p2p1.xsd
                              http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">

    <metadata>
        <schema>ADL SCORM</schema>
        <schemaversion>1.2</schemaversion>
    </metadata>

    <organizations default="curso_discriminacion_org">
        <organization identifier="curso_discriminacion_org">
            <title>Curso de Discriminación</title>
            <item identifier="item_1" identifierref="resource_1">
                <title>Escenarios Interactivos</title>
            </item>
        </organization>
    </organizations>

    <resources>
        <resource identifier="resource_1" type="webcontent" adlcp:scormtype="sco" href="index.html">
            <file href="index.html"/>
            <file href="css/style.css"/>
            <file href="js/script.js"/>
            <file href="js/scorm_wrapper.js"/>
            <!-- Las imagenes y md también forman parte del paquete implícitamente, pero el punto de entrada es index.html -->
        </resource>
    </resources>
</manifest>
